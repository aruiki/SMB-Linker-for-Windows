<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SMBLinker.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:SMBLinker.UI"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Title="SMB Linker for Windows">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (Mica shows through) -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="/Assets/app.ico" Width="16" Height="16" />
                <TextBlock Text="SMB Linker for Windows" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="ContentScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1000" Padding="36,4,36,36" Spacing="{StaticResource SettingsCardSpacing}">

                <!-- Page header -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{ui:Tr Key=main.title}" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{ui:Tr Key=main.subtitle}" Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Click="ReconnectAll_Click" ToolTipService.ToolTip="{ui:Tr Key=tray.reconnectAll}">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource AccentButtonStyle}" Click="Add_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="{ui:Tr Key=main.add}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{ui:Tr Key=main.drivesHeader}" Style="{StaticResource SectionHeaderStyle}" Margin="1,20,0,6" />

                <!-- Empty state -->
                <tk:SettingsCard x:Name="EmptyCard" Header="{ui:Tr Key=main.emptyTitle}" Description="{ui:Tr Key=main.emptyBody}"
                                 IsClickEnabled="True" Click="Add_Click">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8CE;" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>

                <!-- Drives -->
                <ItemsControl x:Name="DriveList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource SettingsCardSpacing}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ui:DriveItem">
                            <tk:SettingsCard Header="{x:Bind Title, Mode=OneWay}" IsClickEnabled="True" Click="Card_Click"
                                             ActionIconToolTip="{ui:Tr Key=main.edit}">
                                <tk:SettingsCard.HeaderIcon>
                                    <ImageIcon Source="{x:Bind IconImage, Mode=OneWay}" />
                                </tk:SettingsCard.HeaderIcon>
                                <tk:SettingsCard.Description>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontFamily="{StaticResource PathFontFamily}" />
                                        <TextBlock Text="{x:Bind Message, Mode=OneWay}" TextWrapping="Wrap" FontFamily="{StaticResource PathFontFamily}"
                                                   Visibility="{x:Bind ShowMessage, Mode=OneWay}" />
                                    </StackPanel>
                                </tk:SettingsCard.Description>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" MinWidth="130">
                                        <Ellipse Width="10" Height="10" Fill="{x:Bind StateBrush, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind StateName, Mode=OneWay}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Content="{ui:Tr Key=main.open}" Click="Open_Click" IsEnabled="{x:Bind IsConnected, Mode=OneWay}" />
                                    <Button Click="More_Click" ToolTipService.ToolTip="{ui:Tr Key=main.more}" Padding="8,6">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </tk:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Settings -->
                <TextBlock Text="{ui:Tr Key=main.settingsHeader}" Style="{StaticResource SectionHeaderStyle}" />

                <tk:SettingsCard Header="{ui:Tr Key=set.startup}" Description="{ui:Tr Key=set.startupDesc}">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="StartupToggle" Toggled="Settings_Changed" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="{ui:Tr Key=set.notify}" Description="{ui:Tr Key=set.notifyDesc}">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEA8F;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="NotifyToggle" Toggled="Settings_Changed" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="{ui:Tr Key=set.autofix}" Description="{ui:Tr Key=set.autofixTip}">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE90F;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="AutoFixToggle" Toggled="Settings_Changed" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="{ui:Tr Key=set.language}" Description="{ui:Tr Key=set.languageRestart}">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xF2B7;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="LanguageBox" MinWidth="160" SelectionChanged="Language_Changed" />
                </tk:SettingsCard>

                <!-- About -->
                <TextBlock Text="{ui:Tr Key=main.aboutHeader}" Style="{StaticResource SectionHeaderStyle}" />
                <tk:SettingsCard x:Name="AboutCard" Header="SMB Linker for Windows">
                    <tk:SettingsCard.HeaderIcon>
                        <ImageIcon Source="/Assets/app.ico" />
                    </tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <HyperlinkButton Content="{ui:Tr Key=main.logs}" Click="Logs_Click" />
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/aruiki/smb-linker-windows" />
                    </StackPanel>
                </tk:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
