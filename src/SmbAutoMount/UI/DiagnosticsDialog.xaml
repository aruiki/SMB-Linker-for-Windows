<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SmbAutoMount.UI.DiagnosticsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:SmbAutoMount.UI"
    Title="{ui:Tr Key=diag.title}"
    PrimaryButtonText="{ui:Tr Key=diag.repair}"
    SecondaryButtonText="{ui:Tr Key=diag.copy}"
    CloseButtonText="{ui:Tr Key=common.close}"
    DefaultButton="Close"
    PrimaryButtonClick="Repair_Click"
    SecondaryButtonClick="Copy_Click">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="12" Width="540">
        <TextBlock x:Name="TargetText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <InfoBar x:Name="SummaryBar" IsOpen="True" IsClosable="False" Severity="Informational" />
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,8">
            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ui:DiagRow">
                            <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind Brush}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
