<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SmbAutoMount.UI.ProfileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:SmbAutoMount.UI"
    PrimaryButtonText="{ui:Tr Key=common.save}"
    CloseButtonText="{ui:Tr Key=common.cancel}"
    DefaultButton="Primary"
    PrimaryButtonClick="Save_Click">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel Spacing="14" Width="520">
            <TextBox x:Name="ServerBox" Header="{ui:Tr Key=pf.server}" PlaceholderText="192.168.0.10" LostFocus="ServerBox_LostFocus">
                <TextBox.Description>
                    <TextBlock Text="{ui:Tr Key=pf.serverHint}" TextWrapping="Wrap" />
                </TextBox.Description>
            </TextBox>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ShareBox" Header="{ui:Tr Key=pf.share}" PlaceholderText="share" />
                <ComboBox x:Name="LetterBox" Grid.Column="1" Header="{ui:Tr Key=pf.letter}" HorizontalAlignment="Stretch" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UserBox" Header="{ui:Tr Key=pf.user}" />
                <PasswordBox x:Name="PasswordInput" Grid.Column="1" Header="{ui:Tr Key=pf.password}" PasswordChanged="Password_Changed" />
            </Grid>
            <TextBlock x:Name="PasswordHint" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-8,0,0" />

            <Expander x:Name="AppearanceExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Padding="0,10">
                        <TextBlock Text="{ui:Tr Key=pf.explorerSection}" />
                        <TextBlock Text="{ui:Tr Key=pf.explorerSectionDesc}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="14">
                    <TextBox x:Name="LabelBox" Header="{ui:Tr Key=pf.label}" PlaceholderText="TrueNAS">
                        <TextBox.Description>
                            <TextBlock Text="{ui:Tr Key=pf.labelHint}" TextWrapping="Wrap" />
                        </TextBox.Description>
                    </TextBox>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{ui:Tr Key=pf.icon}" />
                        <GridView x:Name="IconGallery" SelectionMode="Single" SelectionChanged="IconGallery_SelectionChanged"
                                  IsItemClickEnabled="False" Padding="0">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="ui:IconChoice">
                                    <Grid Width="56" Height="56" ToolTipService.ToolTip="{x:Bind Name}">
                                        <Image Source="{x:Bind Image}" Width="40" Height="40" />
                                        <FontIcon Glyph="&#xEDA2;" Visibility="{x:Bind DefaultVisibility}" FontSize="26"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="4" Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <Image x:Name="IconPreview" Width="24" Height="24" />
                            </Border>
                            <TextBox x:Name="IconBox" Grid.Column="1" TextChanged="IconBox_TextChanged" VerticalAlignment="Center"
                                     PlaceholderText="{ui:Tr Key=pf.iconDefault}" />
                            <Button Grid.Column="2" Content="{ui:Tr Key=pf.iconBrowse}" Click="IconBrowse_Click" />
                        </Grid>
                        <TextBlock Text="{ui:Tr Key=pf.iconHint}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <ToggleSwitch x:Name="EnabledToggle" Header="{ui:Tr Key=pf.enabled}" IsOn="True" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="TestButton" Click="Test_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE703;" FontSize="14" />
                        <TextBlock Text="{ui:Tr Key=pf.test}" />
                    </StackPanel>
                </Button>
                <ProgressRing x:Name="TestRing" IsActive="False" Width="20" Height="20" />
            </StackPanel>
            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
